# All optional. The app works without any of them (guest mode + local-only Pythia).

# Cloudflare Worker AI proxy (see DEPLOY.md)
VITE_AI_PROXY_URL=

# Supabase (see DEPLOY.md). The anon key is public by design; Row Level Security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Self-hosted Pyodide (must end with "/"). Empty = jsDelivr CDN. `npm run pyodide:local` copies the core to /pyodide/.
VITE_PYODIDE_BASE=
